# Copia este archivo a .env (no se versiona) y rellénalo.

# Token del túnel de Cloudflare (Zero Trust → Networks → Tunnels → tu túnel → "Install connector":
# la cadena larga que va después de --token). La ruta pública del túnel apunta a http://rona-web:80
TUNNEL_TOKEN=

# El servidor va detrás de nginx: toma la IP real de X-Forwarded-For (nginx la llena con CF-Connecting-IP).
# No lo quites, o todos los jugadores contarán como la IP del contenedor nginx para los topes por IP.
TRUST_PROXY=1

# Orígenes permitidos por CORS (opcional; vacío = cualquiera). El cliente usa el mismo origen, así que
# no hace falta; si lo pones, usa tu dominio público, p. ej. https://rona.midominio.com
CLIENT_ORIGIN=

# Inicio de sesión con Google (Google Identity Services). Vacío = sin botón de Google: todos juegan como
# invitados, como antes. Es el "ID de cliente" de un cliente OAuth tipo "Aplicación web" en Google Cloud
# (APIs y servicios → Credenciales), con orígenes de JavaScript autorizados https://rona.1200602.xyz
# y http://localhost:5173. No es secreto (el navegador lo ve), y no hace falta el "secreto de cliente".
GOOGLE_CLIENT_ID=

# Las cuentas, estadísticas y amigos se guardan en SQLite en el volumen rona-data (DATA_DIR=/data
# dentro del contenedor). AUTH_DEV_FAKE no aplica aquí: en producción siempre está apagado.

# Topes por IP (0 = sin tope). Súbelos si juega mucha gente desde la misma red (escuela, NAT)
MAX_CONNECTIONS_PER_IP=20
SESSIONS_PER_IP_PER_MIN=20
MAX_ROOMS_PER_IP=8

# Tiempos (ms)
TURN_MS=40000
GRACE_MS=60000
BOT_MIN_MS=1800
BOT_MAX_MS=3200

# LOG=0 apaga los logs del servidor
LOG=1
